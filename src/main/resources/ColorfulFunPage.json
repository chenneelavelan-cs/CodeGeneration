{
    "css": {
        "colorful-styles": {
            "fileName": "colorful-styles",
            "rules": [
                {
                    "selector": "* ",
                    "properties": {
                        "margin": "0",
                        "padding": "0",
                        "box-sizing": "border-box"
                    }
                },
                {
                    "selector": "body",
                    "properties": {
                        "font-family": "'Comic Sans MS', 'Trebuchet MS', cursive",
                        "background": "linear-gradient(45deg, #FF6B6B, #4ECDC4, #45B7D1, #96CEB4, #FFEAA7, #DDA0DD)",
                        "background-size": "400% 400%",
                        "animation": "gradientShift 8s ease infinite",
                        "min-height": "100vh",
                        "overflow-x": "hidden"
                    }
                },
                {
                    "selector": "@keyframes gradientShift",
                    "properties": {
                        "0%": "background-position: 0% 50%",
                        "50%": "background-position: 100% 50%",
                        "100%": "background-position: 0% 50%"
                    }
                },
                {
                    "selector": ".header",
                    "properties": {
                        "text-align": "center",
                        "padding": "3rem 2rem",
                        "background": "rgba(255, 255, 255, 0.15)",
                        "backdrop-filter": "blur(10px)",
                        "margin": "2rem",
                        "border-radius": "25px",
                        "box-shadow": "0 15px 35px rgba(0, 0, 0, 0.1)",
                        "transform": "translateY(0)",
                        "transition": "all 0.3s ease"
                    }
                },
                {
                    "selector": ".header:hover",
                    "properties": {
                        "transform": "translateY(-10px)",
                        "box-shadow": "0 25px 45px rgba(0, 0, 0, 0.2)"
                    }
                },
                {
                    "selector": ".rainbow-title",
                    "properties": {
                        "font-size": "4rem",
                        "font-weight": "bold",
                        "background": "linear-gradient(45deg, #FF6B6B, #4ECDC4, #45B7D1, #96CEB4, #FFEAA7, #DDA0DD, #FF6B6B)",
                        "background-size": "200% 200%",
                        "-webkit-background-clip": "text",
                        "background-clip": "text",
                        "-webkit-text-fill-color": "transparent",
                        "animation": "rainbowAnimation 3s ease-in-out infinite",
                        "margin-bottom": "1rem",
                        "text-shadow": "2px 2px 4px rgba(0, 0, 0, 0.3)"
                    }
                },
                {
                    "selector": "@keyframes rainbowAnimation",
                    "properties": {
                        "0%, 100%": "background-position: 0% 50%",
                        "50%": "background-position: 100% 50%"
                    }
                },
                {
                    "selector": ".subtitle",
                    "properties": {
                        "font-size": "1.5rem",
                        "color": "#2C3E50",
                        "margin-bottom": "2rem",
                        "animation": "bounce 2s infinite"
                    }
                },
                {
                    "selector": "@keyframes bounce",
                    "properties": {
                        "0%, 20%, 50%, 80%, 100%": "transform: translateY(0)",
                        "40%": "transform: translateY(-10px)",
                        "60%": "transform: translateY(-5px)"
                    }
                },
                {
                    "selector": ".container",
                    "properties": {
                        "max-width": "1200px",
                        "margin": "0 auto",
                        "padding": "2rem",
                        "display": "grid",
                        "grid-template-columns": "repeat(auto-fit, minmax(300px, 1fr))",
                        "gap": "2rem"
                    }
                },
                {
                    "selector": ".fun-card",
                    "properties": {
                        "background": "rgba(255, 255, 255, 0.2)",
                        "backdrop-filter": "blur(10px)",
                        "border-radius": "20px",
                        "padding": "2rem",
                        "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.1)",
                        "border": "1px solid rgba(255, 255, 255, 0.3)",
                        "transition": "all 0.3s ease",
                        "cursor": "pointer"
                    }
                },
                {
                    "selector": ".fun-card:hover",
                    "properties": {
                        "transform": "translateY(-15px) scale(1.05)",
                        "box-shadow": "0 20px 40px rgba(0, 0, 0, 0.2)"
                    }
                },
                {
                    "selector": ".card-icon",
                    "properties": {
                        "font-size": "4rem",
                        "margin-bottom": "1rem",
                        "animation": "rotate 4s linear infinite"
                    }
                },
                {
                    "selector": "@keyframes rotate",
                    "properties": {
                        "0%": "transform: rotate(0deg)",
                        "100%": "transform: rotate(360deg)"
                    }
                },
                {
                    "selector": ".card-title",
                    "properties": {
                        "font-size": "1.8rem",
                        "font-weight": "bold",
                        "color": "#2C3E50",
                        "margin-bottom": "1rem"
                    }
                },
                {
                    "selector": ".card-text",
                    "properties": {
                        "font-size": "1.1rem",
                        "color": "#34495E",
                        "line-height": "1.6"
                    }
                },
                {
                    "selector": ".magic-button",
                    "properties": {
                        "background": "linear-gradient(45deg, #FF6B6B, #4ECDC4)",
                        "color": "white",
                        "border": "none",
                        "padding": "15px 30px",
                        "font-size": "1.2rem",
                        "border-radius": "50px",
                        "cursor": "pointer",
                        "transition": "all 0.3s ease",
                        "margin-top": "1rem",
                        "box-shadow": "0 5px 15px rgba(0, 0, 0, 0.2)"
                    }
                },
                {
                    "selector": ".magic-button:hover",
                    "properties": {
                        "transform": "scale(1.1)",
                        "box-shadow": "0 10px 25px rgba(0, 0, 0, 0.3)"
                    }
                },
                {
                    "selector": ".floating-emoji",
                    "properties": {
                        "position": "absolute",
                        "font-size": "2rem",
                        "animation": "float 6s ease-in-out infinite",
                        "pointer-events": "none"
                    }
                },
                {
                    "selector": "@keyframes float",
                    "properties": {
                        "0%, 100%": "transform: translateY(0px)",
                        "50%": "transform: translateY(-20px)"
                    }
                },
                {
                    "selector": ".footer",
                    "properties": {
                        "text-align": "center",
                        "padding": "3rem",
                        "background": "rgba(255, 255, 255, 0.1)",
                        "margin-top": "3rem",
                        "color": "#2C3E50",
                        "font-size": "1.2rem"
                    }
                },
                {
                    "selector": ".pulse",
                    "properties": {
                        "animation": "pulse 2s infinite"
                    }
                },
                {
                    "selector": "@keyframes pulse",
                    "properties": {
                        "0%": "transform: scale(1)",
                        "50%": "transform: scale(1.05)",
                        "100%": "transform: scale(1)"
                    }
                }
            ]
        }
    },
    "js": {
        "magical-fun": {
            "fileName": "magical-fun",
            "statements": [
                {
