                    }
                },
                {
                    "type": "functionDeclaration",
                    "functionName": "addMagicalEffects",
                    "parameters": [],
                    "statements": [
                        {
                            "type": "variableDeclaration",
                            "variableName": "cards",
                            "value": {
                                "type": "propertyAccess",
                                "object": "document",
                                "property": "querySelectorAll('.fun-card')"
                            }
                        }
                    ]
                },
                {
                    "type": "functionDeclaration",
                    "functionName": "initializeFunPage",
                    "parameters": [],
                    "statements": [
                        {
                            "type": "expressionStatement",
                            "expression": {
                                "type": "functionCall",
                                "functionName": {
                                    "type": "literal",
                                    "value": "addMagicalEffects"
                                },
                                "arguments": []
                            }
                        }
                    ]
                },
                {
                    "type": "expressionStatement",
                    "expression": {
                        "type": "functionCall",
                        "functionName": {
                            "type": "literal",
                            "value": "document.addEventListener"
                        },
                        "arguments": [
                            {
                                "type": "literal",
                                "value": "'DOMContentLoaded'"
                            },
                            {
                                "type": "literal",
                                "value": "initializeFunPage"
                            }
                        ]
                    }
                }
            ]
        }
    },
